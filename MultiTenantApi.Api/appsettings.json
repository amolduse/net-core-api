{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Honeycomb": {
    "ApiKey": "YOUR_API_KEY_HERE",
    "ServiceName": "MultiTenantApi"
  },
  "AWS": {
    "Region": "us-east-1",
    "CredentialsSecretName": "YOUR_SECRET_NAME_HERE"
  },
  "ConnectionStrings": {
    "ConfigDb": "YOUR_CONFIG_DB_CONNECTION_STRING_HERE"
  },
  "Database": {
    "TenantDbServer": "your-tenant-db-server",
    "SharedDbServer": "your-shared-db-server"
  }
}
